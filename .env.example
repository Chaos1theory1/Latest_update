# Biotech Agro - Vercel Environment Variables
# Never commit real secrets. Add real values only in Vercel Dashboard > Project > Settings > Environment Variables.

# Admin login. This is the safest permanent admin login on Vercel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=azerty
ADMIN_EMAIL=biotechagro.digital@gmail.com
SESSION_SECRET=AZERTYUIOPQ125667890

# Let the reset screen show a temporary code if SMTP is not configured or fails.
# For testing, keep true. For production-only email delivery, set false.
RESET_CODE_SCREEN_FALLBACK=true

# Gmail SMTP reset/contact email delivery.
# Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=biotechagro.digital@gmail.com
SMTP_PASS=bauivbnrjbuaepmn
SMTP_SENDER_NAME=Biotech Agro Admin Control

# Optional AI assistant key.
GEMINI_API_KEY=your_gemini_api_key_here
